# --- 必須 ---
# Konnect 上のリソース名と namespace の接頭辞。同じ org の他人と被らない値にする（英小文字・数字・ハイフン）
PREFIX=""
KONNECT_PAT=""

# --- 任意 ---
KONNECT_REGION="us"
KONG_PROXY_PORT="18000"
KONG_STATUS_PORT="18100"

# Virtual Key を発行する Principal。mise run principals -- <名前の一部> で探す
PRINCIPAL_ID=""

# Virtual Key。mise run setup が発行してここに書く。1Password に置くなら空にして *_OP_REF を使う
KONG_VIRTUAL_KEY=""
KONG_VIRTUAL_KEY_OP_REF=""

# このパス配下のリポジトリでは、リポジトリ名・ブランチを Konnect のタグに送らない（コロン区切り）
SCM_TAG_EXCLUDE_DIRS=""

# --- mise run setup が書く ---
CONTROL_PLANE_ID=""
